\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{p{0.82\textwidth}@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{p{0.82\textwidth}@{\extracolsep{\fill}}r}
      \small#1 & #2 \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}\vspace{-4pt}}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

\begin{document}

\begin{center}
    \textbf{\Huge \scshape {{personal.name}}} \\ \vspace{1pt}
    \small {{personal.phone}} $|$ \href{mailto:{{personal.email}}}{\underline{{{personal.email}}}} $|$ 
    \href{{{personal.linkedin}}}{\underline{LinkedIn}} $|$
    \href{{{personal.github}}}{\underline{GitHub}}
\end{center}

\section{Education}
  \resumeSubHeadingListStart
    \resumeSubheading
      {{{education.university}}}{{{education.location}}}
      {{{education.degree}}{{#if education.gpa}} $|$ GPA: {{education.gpa}}{{/if}}}{{{education.dates}}}
  \resumeSubHeadingListEnd

{{#if experience}}
\section{Experience}
  \resumeSubHeadingListStart
    {{#each experience}}
    \resumeSubheading
      {{{title}}}{{{dates}}}
      {{{company}}}{{{location}}}
      {{#if bullets}}
      \resumeItemListStart
        {{#each bullets}}
        \resumeItem{{{this}}}
        {{/each}}
      \resumeItemListEnd
      {{/if}}
    {{/each}}
  \resumeSubHeadingListEnd
{{/if}}

{{#if projects}}
\section{Projects}
  \resumeSubHeadingListStart
    {{#each projects}}
    \resumeSubheading
      {{{name}}}{{{dates}}}
      {\emph{{{technologies}}}}{}
      {{#if bullets}}
      \resumeItemListStart
        {{#each bullets}}
        \resumeItem{{{this}}}
        {{/each}}
      \resumeItemListEnd
      {{/if}}
    {{/each}}
  \resumeSubHeadingListEnd
{{/if}}

{{#if certifications}}
\section{Certifications}
  \resumeSubHeadingListStart
    {{#each certifications}}
      {{#if name}}
      \resumeProjectHeading
          {\textbf{{{name}}} $|$ \emph{{{issuer}}}}{{{date}}}
      {{/if}}
    {{/each}}
  \resumeSubHeadingListEnd
{{/if}}

